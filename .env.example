# ─────────────────────────────────────────────────────────────
#  PERSONAL FINANCE DASHBOARD — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  The .env file is git-ignored and should NEVER be committed.
#  On Replit: add each value in the Secrets panel, not here.
# ─────────────────────────────────────────────────────────────

# ── Plaid ────────────────────────────────────────────────────
# Get these from https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
# sandbox (fake data) → production (real accounts). Plaid retired "development".
PLAID_ENV=sandbox

# ── Fidelity OFX Direct Connect ──────────────────────────────
# These are your regular Fidelity login credentials.
# OFX uses them to talk directly to Fidelity (like Quicken does).
# See THE-VISION/SETUP.md for step-by-step Fidelity OFX setup.
FIDELITY_USER=your_fidelity_username
FIDELITY_PIN=your_fidelity_password
FIDELITY_ACCOUNT_ID=your_fidelity_account_number

# ── App Security ─────────────────────────────────────────────
# Generate once with: python scripts/generate_key.py
# This encrypts Plaid access tokens stored in the database.
ENCRYPTION_KEY=your_generated_fernet_key_here

# Dashboard PIN gate. This is the ONLY thing protecting the dashboard UI.
#
#   * Set DASHBOARD_PIN to a STRONG, unique value (not "1234", not your name).
#     The backend then requires it on every /api/* request via the
#     X-Dashboard-Pin header, and the React AuthGate shows a "Dashboard locked"
#     screen until an unlocked PIN is entered (correct = unlock, wrong = error).
#
#   * A MISSING / BLANK DASHBOARD_PIN means the dashboard is OPEN — NO
#     authentication at all. Anyone who knows the URL can read your financial
#     data. If this app should be protected in production, you MUST set a real
#     value here. Leaving it blank is a footgun, not a feature: see
#     backend/auth.py for the explicit warning logged at startup.
#
#   * Pair with HTTPS so the PIN is never sent in the clear.
#
DASHBOARD_PIN=

# ── App Config ───────────────────────────────────────────────
DATABASE_URL=sqlite:///./finance.db
SYNC_INTERVAL_HOURS=4
BACKEND_URL=http://localhost:8000

# On Replit, set this to your public Replit URL:
# https://your-project-name.your-username.repl.co
APP_BASE_URL=http://localhost:5173