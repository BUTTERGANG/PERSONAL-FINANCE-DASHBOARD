.env
*.db
*.sqlite
*.sqlite3
finance.db

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.Python
pip-log.txt
*.egg-info/
dist/
build/
.eggs/

# Replit
.replit.nix.lock
.config/
.upm/

