#!/bin/bash
# Git pre-commit hook: blocks commits of secrets files.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

BLOCKED=$(git diff --staged --name-only | grep -E '\.env$|finance\.db$|\.sqlite$|\.key$|plaid_tokens')

if [ -n "$BLOCKED" ]; then
  echo ""
  echo "🚫 COMMIT BLOCKED — attempting to commit a sensitive file:"
  echo "$BLOCKED"
  echo ""
  echo "These files are git-ignored for a reason. Do not commit them."
  echo "If this was accidental, run: git reset HEAD <filename>"
  echo ""
  exit 1
fi
